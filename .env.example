# ============ RAG 服务配置 ============

# 嵌入模型（中文推荐 bge-large-zh-v1.5）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 嵌入模式: semantic(向量，效果好，需下载模型) | tfidf(零下载兜底)
EMBEDDING_MODE=semantic

# 文本分块
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索命中数
TOP_K=5

# LLM —— OpenAI 兼容（Ollama 本地 / DeepSeek / 其他）
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TIMEOUT=180.0

# 向量库目录
VECTOR_DB_DIR=vector_db

# 服务端口
HOST=0.0.0.0
PORT=8000
