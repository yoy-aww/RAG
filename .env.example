# ============ RAG 服务配置 ============

# 嵌入模型（中文推荐 bge-large-zh-v1.5）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 嵌入模式: semantic(向量，效果好，需下载模型) | tfidf(零下载兜底)
EMBEDDING_MODE=semantic

# 文本分块
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索命中数
TOP_K=5

# LLM —— OpenAI 兼容（Ollama 本地 / DeepSeek / 其他）
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TIMEOUT=180.0

# 向量库目录
VECTOR_DB_DIR=vector_db

# 服务端口
HOST=0.0.0.0
PORT=8000

# ============ 多租户鉴权 ============
# ALLOW_ANON=true 时，不带 X-API-Key 的请求落到默认租户（本地开发方便）；
# 生产必须设 false，所有请求强制带 key。
ALLOW_ANON=true
# 默认租户 tenant_001 的 API key；留空则首次启动自动生成并打印
DEFAULT_API_KEY=
# 管理端点 (/admin/*) 鉴权 key，生产必改
ADMIN_API_KEY=admin-dev-key

# ============ MySQL (Text-to-SQL 通道) ============
MYSQL_ENABLED=false              # true 才启用 SQL 通道，默认关
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=rag_ro                # 只读账号
MYSQL_PASSWORD=ro123
MYSQL_DATABASE=yoyac_pv
MYSQL_CHARSET=utf8mb4
MYSQL_READ_ONLY=true             # 强制 SQL 只允许 SELECT（代码层再检一次）
MYSQL_MAX_ROWS=100               # SQL 结果最多返回多少行，防 context 爆
